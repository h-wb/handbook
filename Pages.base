filters:
  or:
    - kind == "overview"
    - kind == "how-to"
    - kind == "decision"
    - kind == "reference"
    - kind == "plan"
formulas:
  due: 'if(kind == "decision" || status == "superseded" || status == "archived", false, if(kind == "how-to", reviewed < today() - "90d", if(kind == "plan", reviewed < today() - "30d", reviewed < today() - "180d")))'
properties:
  file.name:
    displayName: Page
  formula.due:
    displayName: Due for review
views:
  - type: table
    name: All pages
    order:
      - file.name
      - kind
      - system
      - status
      - reviewed
      - formula.due
      - summary
  - type: table
    name: Due for review
    filters:
      and:
        - formula.due == true
    order:
      - file.name
      - kind
      - system
      - reviewed
      - summary
  - type: table
    name: By system
    groupBy:
      property: note.system
      direction: ASC
    order:
      - file.name
      - kind
      - status
      - reviewed
      - summary
